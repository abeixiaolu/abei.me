{
  "name": "abei.me",
  "version": "1.0.0",
  "private": true,
  "description": "abei.me — Solid 2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "og:generate": "node scripts/generate-og.mjs",
    "build": "node scripts/generate-og.mjs && vite build && node scripts/write-spa-shells.mjs",
    "serve": "vite preview",
    "test": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck",
    "typora:upload": "node scripts/typora-upload.mjs",
    "images:meta": "node scripts/backfill-image-meta.mjs",
    "check:images": "node scripts/check-content-images.mjs",
    "prepare": "git config core.hooksPath .githooks"
  },
  "license": "MIT",
  "devDependencies": {
    "@egoist/tailwindcss-icons": "^1.9.2",
    "@iconify/json": "^2.2.560",
    "@octokit/rest": "^22.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@shikijs/rehype": "^3.15.0",
    "@solidjs/diagnostics": "^2.0.0",
    "@solidjs/testing-library": "^1.0.0-rc.2",
    "@solidjs/vite-plugin": "^3.0.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@types/node": "^26.6.6",
    "eslint-plugin-solid": "~0.20.0",
    "filesystem-routing": "0.5.0",
    "gray-matter": "^4.0.3",
    "jsdom": "^31.0.0",
    "oxlint": "~1.92.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-github-blockquote-alert": "^2.1.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.5",
    "shiki": "^3.15.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "unified": "^11.0.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "zod": "^4.1.12"
  },
  "dependencies": {
    "@solidjs/meta": "^2.0.0",
    "@solidjs/router": "^2.0.0",
    "@solidjs/web": "^2.0.0",
    "solid-js": "^2.0.0"
  },
  "packageManager": "pnpm@12.21.0"
}
