---
/**
 * SPEC-01 / Hardware · 51 Item list
 * 灰色 LCD 托盘：表头 + 行，选中/悬停时两侧细线指示。
 * @see https://spec-01.vercel.app/
 */
interface Props {
  /** 列模板，默认标题 + 右对齐日期 */
  columns?: string;
  class?: string;
}

const {
  columns = "minmax(0, 1fr) auto",
  class: className,
} = Astro.props;
---

<div
  class:list={["hw-item-list", className]}
  style={`--columns: ${columns}`}
>
  <slot />
</div>
