---
import StnHeader from "../components/StnHeader.astro";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const {
  title,
  description,
  caption,
  meta,
  lede,
} = frontmatter;
---

<BaseLayout title={title} description={description}>
  <section>
    <StnHeader caption={caption} meta={meta} title={title} lede={lede} />

    <div class="hw-prose mt-8">
      <slot />
    </div>
  </section>
</BaseLayout>
