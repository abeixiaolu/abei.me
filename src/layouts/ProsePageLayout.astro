---
import Lcd from "../components/Lcd.astro";
import BaseLayout from "./BaseLayout.astro";

const { frontmatter } = Astro.props;
const {
  title,
  description,
  caption,
  lede,
} = frontmatter;
---

<BaseLayout title={title} description={description}>
  <section>
    <Lcd size="lg">
      {caption && <p class="hw-caption">{caption}</p>}
      <h1 class="hw-title">{title}</h1>
      {lede && <p class="hw-lede">{lede}</p>}
    </Lcd>

    <div class="hw-prose mt-8">
      <slot />
    </div>
  </section>
</BaseLayout>
