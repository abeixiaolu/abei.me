---
/**
 * SPEC-01 / Hardware · 34 Badge
 * @see https://spec-01.vercel.app/
 */
interface Props {
  tone?: "neutral" | "info" | "success" | "warning" | "danger";
  /** 长文案可换行（文章描述等） */
  wrap?: boolean;
  class?: string;
}

const {
  tone = "neutral",
  wrap = false,
  class: className,
} = Astro.props;
---

<span
  class:list={["hw-badge", className]}
  data-tone={tone === "neutral" ? undefined : tone}
  data-wrap={wrap ? "" : undefined}
>
  <slot />
</span>
