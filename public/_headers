# HTML：给浏览器可复用的新鲜期。Astro prefetch / ClientRouter 的 fetch
# 只有在 max-age>0 时才会命中 HTTP 缓存；must-revalidate + max-age=0 会导致每次再拉一遍。
# CF Pages 对 HTML 默认仍是 DYNAMIC（边缘不吃 s-maxage），真正瞬时切换靠 NavHtmlCache。
/
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/diary/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/blog/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/projects/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/uses/*
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
