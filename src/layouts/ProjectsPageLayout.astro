---
import Badge from "../components/Badge.astro";
import StnHeader from "../components/StnHeader.astro";
import BaseLayout from "./BaseLayout.astro";

interface Project {
  name: string;
  description: string;
  /** @deprecated 请改用 repo / live */
  url?: string;
  repo?: string;
  live?: string;
}

interface ProjectGroup {
  title: string;
  projects: Project[];
}

const { frontmatter } = Astro.props;
const {
  title,
  description,
  caption,
  meta,
  lede,
  groups = [],
} = frontmatter as {
  title: string;
  description?: string;
  caption?: string;
  meta?: string;
  lede?: string;
  groups?: ProjectGroup[];
};

function isRepo(url: string) {
  try {
    return new URL(url).hostname.includes("github.com");
  } catch {
    return false;
  }
}

/** 兼容旧 url 字段，拆成 repo / live */
function resolveLinks(project: Project) {
  let repo = project.repo;
  let live = project.live;
  if (project.url) {
    if (isRepo(project.url)) repo ??= project.url;
    else live ??= project.url;
  }
  return { repo, live };
}

function padIndex(n: number) {
  return String(n).padStart(2, "0");
}

const totalPads = groups.reduce((sum, g) => sum + g.projects.length, 0);
const headerMeta = meta ?? `MODE ${padIndex(totalPads)}`;
---

<BaseLayout title={title} description={description}>
  <section>
    <StnHeader
      caption={caption}
      meta={headerMeta}
      title={title}
      lede={lede}
    />

    <div class="mt-8 space-y-8">
      {
        groups.map((group) => (
          <div>
            <div class="mb-3 flex items-center justify-between gap-3">
              <Badge>{group.title}</Badge>
              <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-dim">
                Bank · {padIndex(group.projects.length)} pads
              </span>
            </div>

            <div class="hw-pad-bank">
              <ul class="hw-pad-grid">
                {group.projects.map((project, i) => {
                  const { repo, live } = resolveLinks(project);
                  // 整卡优先进 Live，没有再进 Repo
                  const primary = live ?? repo;
                  return (
                    <li>
                      <div class="hw-key hw-pad">
                        {primary && (
                          <a
                            class="hw-pad-stretch"
                            href={primary}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={project.name}
                          />
                        )}
                        <div class="hw-key-pad hw-pad-face">
                          <div class="hw-pad-meta">
                            <span class="hw-pad-index">{padIndex(i + 1)}</span>
                            <span class="hw-pad-actions">
                              {repo && (
                                <a
                                  class="hw-pad-action"
                                  href={repo}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  data-tone="repo"
                                >
                                  <span
                                    class="hw-pad-led"
                                    data-tone="repo"
                                    aria-hidden="true"
                                  />
                                  Repo
                                </a>
                              )}
                              {live && (
                                <a
                                  class="hw-pad-action"
                                  href={live}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  data-tone="live"
                                >
                                  <span
                                    class="hw-pad-led"
                                    data-tone="live"
                                    aria-hidden="true"
                                  />
                                  Live
                                </a>
                              )}
                            </span>
                          </div>

                          <span class="hw-pad-title">
                            <span
                              class:list={[
                                "shrink-0 text-base opacity-70",
                                live
                                  ? "i-carbon-direction-right-01-filled"
                                  : "i-carbon-logo-github",
                              ]}
                              aria-hidden="true"
                            />
                            {project.name}
                          </span>

                          <span class="hw-pad-desc">{project.description}</span>
                        </div>
                      </div>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
