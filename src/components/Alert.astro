---
/**
 * SPEC-01 / Hardware · 33 Alert
 * @see https://spec-01.vercel.app/
 */
interface Props {
  title?: string;
  tone?: "neutral" | "info" | "success" | "warning" | "danger";
  class?: string;
}

const {
  title = "Note",
  tone = "info",
  class: className,
} = Astro.props;
---

<div
  class:list={["hw-alert", className]}
  data-tone={tone}
  role={tone === "danger" ? "alert" : "status"}
>
  <div class="hw-alert-legend">
    <span class="hw-alert-led" aria-hidden="true"></span>
    <strong class="hw-alert-title">{title}</strong>
  </div>
  <p class="hw-alert-desc">
    <slot />
  </p>
</div>
