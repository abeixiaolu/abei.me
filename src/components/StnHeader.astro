---
/**
 * 千禧年 STN 字符液晶页头
 * 绿黄屏 + 塑料边框，标题大写印在屏上。
 */
interface Props {
  /** 左上角模式铭刻，如 Index */
  caption?: string;
  /** 右上角读数，如 MODE 01 */
  meta?: string;
  title: string;
  lede?: string;
  class?: string;
}

const {
  caption,
  meta,
  title,
  lede,
  class: className,
} = Astro.props;
---

<header class:list={["hw-stn", className]}>
  <div class="hw-stn-bezel">
    <div class="hw-stn-glass">
      {
        (caption || meta) && (
          <div class="hw-stn-top">
            {caption && <span>{caption}</span>}
            {meta && <span>{meta}</span>}
          </div>
        )
      }
      <h1 class="hw-stn-title">{title}</h1>
      {lede && <p class="hw-stn-lede">{lede}</p>}
    </div>
  </div>
</header>
