---
import Badge from "../../components/Badge.astro";
import Lcd from "../../components/Lcd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { projectGroups } from "../../data/projects";
---

<BaseLayout title="Projects" description="开源与个人项目。">
  <section>
    <Lcd size="lg">
      <p class="hw-caption">Catalog</p>
      <h1 class="hw-title">Projects</h1>
      <p class="hw-lede">开源与个人项目。</p>
    </Lcd>

    <div class="mt-8 space-y-8">
      {
        projectGroups.map((group) => (
          <div>
            <div class="mb-3 flex items-center gap-2">
              <Badge>{group.title}</Badge>
            </div>
            <ul class="grid gap-2 sm:grid-cols-1">
              {group.projects.map((project) => (
                <li>
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hw-key"
                  >
                    <span class="hw-key-pad flex items-start justify-between gap-4">
                      <span class="min-w-0">
                        <span class="inline-flex items-center gap-2 font-medium">
                          <span
                            class="i-carbon-logo-github text-base opacity-70"
                            aria-hidden="true"
                          />
                          {project.name}
                        </span>
                        <span class="mt-1.5 block text-[12px] leading-relaxed text-dim">
                          {project.description}
                        </span>
                      </span>
                      <span
                        class="i-carbon-arrow-up-right mt-0.5 shrink-0 text-dim"
                        aria-hidden="true"
                      />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
