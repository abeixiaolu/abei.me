---
/**
 * SPEC-01 / Hardware · FlatKnob 风格阅读进度
 * 右下角悬浮小玩具：顶行 LED + READ + 进度，下方旋钮随滚动点亮。
 * @see https://spec-01.vercel.app/paint
 */
interface Props {
  /** 滚动追踪目标选择器，默认 article */
  target?: string;
}

const { target = "article" } = Astro.props;
---

<div
  class="hw-reading-progress"
  role="progressbar"
  aria-label="阅读进度"
  aria-valuemin="0"
  aria-valuemax="100"
  aria-valuenow="0"
  data-target={target}
  style="--progress: 0; --lit: 0; --turn: -135deg"
>
  <div class="hw-reading-toy" aria-hidden="true">
    <div class="hw-reading-head">
      <span class="hw-reading-brand">
        <span class="hw-reading-led" data-lit="false"></span>
        <span class="hw-reading-label">Read</span>
      </span>
      <output class="hw-reading-readout">0</output>
    </div>
    <div class="hw-reading-dial">
      <div class="hw-reading-cap"></div>
    </div>
  </div>
</div>

<script>
  function initReadingProgress(root: HTMLElement) {
    const selector = root.dataset.target || "article";
    const readout = root.querySelector<HTMLElement>(".hw-reading-readout");
    const led = root.querySelector<HTMLElement>(".hw-reading-led");
    if (!readout || !led) return;

    let frame = 0;

    const setProgress = (progress: number) => {
      const pct = Math.round(progress * 100);
      // FlatKnob：270° 扫过，-135° → +135°
      const turn = -135 + progress * 270;
      root.style.setProperty("--progress", String(progress));
      root.style.setProperty("--lit", String(progress));
      root.style.setProperty("--turn", `${turn}deg`);
      root.setAttribute("aria-valuenow", String(pct));
      root.toggleAttribute("data-complete", progress >= 1);
      readout.textContent = String(pct);
      led.dataset.lit = progress >= 1 ? "true" : "false";
    };

    const update = () => {
      frame = 0;
      const target = document.querySelector<HTMLElement>(selector);
      if (!target) {
        root.hidden = true;
        return;
      }

      root.hidden = false;

      const viewH = window.innerHeight;
      const height = target.offsetHeight;
      const rect = target.getBoundingClientRect();
      const scrollable = height - viewH;

      let progress = 1;
      if (scrollable > 0) {
        // rect.top = 0 起读；文章底边贴齐视口底边时 = 1
        progress = Math.min(1, Math.max(0, -rect.top / scrollable));
      }

      // 整页滚到底强制 100%，避免脚注/页脚导致差一截
      const doc = document.documentElement;
      const atEnd =
        window.scrollY + viewH >= doc.scrollHeight - 2 ||
        rect.bottom <= viewH + 1;
      if (atEnd) progress = 1;

      setProgress(progress);
    };

    const onScroll = () => {
      if (frame) return;
      frame = requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  }

  const boot = () => {
    document
      .querySelectorAll<HTMLElement>(".hw-reading-progress")
      .forEach(initReadingProgress);
  };

  boot();
  document.addEventListener("astro:page-load", boot);
</script>
