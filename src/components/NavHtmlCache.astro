---
/**
 * ClientRouter 每次导航会再 fetch 整页 HTML；Astro 自带的 <link rel=prefetch>
 * 只进 HTTP 缓存，碰上 max-age=0 / CF DYNAMIC 时点一下仍要等网络。
 * 这里用会话内存缓存 + before-preparation 短路，接近 VitePress 的体感。
 */
---

<script>
  type PageCache = { html: string; mediaType: string; redirected?: string };

  declare global {
    interface Window {
      __abeiHtmlCacheBound?: boolean;
    }
  }

  const cache = new Map<string, PageCache>();
  const inflight = new Map<string, Promise<PageCache | null>>();

  function canon(href: string) {
    const u = new URL(href, location.href);
    u.hash = "";
    return u.href;
  }

  async function fetchPage(href: string, signal?: AbortSignal): Promise<PageCache | null> {
    try {
      const res = await fetch(href, { signal });
      const mediaType = (res.headers.get("content-type") ?? "").split(";", 1)[0].trim();
      if (mediaType !== "text/html" && mediaType !== "application/xhtml+xml") return null;
      const html = await res.text();
      return {
        html,
        mediaType,
        redirected: res.redirected ? res.url : undefined,
      };
    } catch {
      return null;
    }
  }

  function warm(href: string) {
    const key = canon(href);
    if (cache.has(key) || inflight.has(key)) return;
    if (!navigator.onLine) return;

    try {
      const u = new URL(key);
      if (u.origin !== location.origin) return;
      if (u.pathname === location.pathname && u.search === location.search) return;
    } catch {
      return;
    }

    const job = fetchPage(key).then((page) => {
      if (page) {
        cache.set(key, page);
        if (page.redirected) cache.set(canon(page.redirected), page);
      }
      inflight.delete(key);
      return page;
    });
    inflight.set(key, job);
  }

  function warmLinks(root: ParentNode = document) {
    root.querySelectorAll<HTMLAnchorElement>("a[href]").forEach((a) => {
      if (a.hasAttribute("download")) return;
      if (a.target && a.target !== "_self") return;
      warm(a.href);
    });
  }

  async function preloadStyles(doc: Document) {
    const tasks: Promise<unknown>[] = [];
    for (const link of doc.querySelectorAll("head link[rel=stylesheet]")) {
      const href = link.getAttribute("href");
      if (!href) continue;
      if (
        document.querySelector(
          `link[rel=stylesheet][href="${href}"], link[rel=preload][as=style][href="${href}"]`,
        )
      ) {
        continue;
      }
      const preload = document.createElement("link");
      preload.rel = "preload";
      preload.as = "style";
      preload.href = href;
      tasks.push(
        new Promise((resolve) => {
          ["load", "error"].forEach((ev) => preload.addEventListener(ev, resolve));
          document.head.append(preload);
        }),
      );
    }
    if (tasks.length) await Promise.all(tasks);
  }

  if (!window.__abeiHtmlCacheBound) {
    window.__abeiHtmlCacheBound = true;

    document.addEventListener("astro:before-preparation", (event) => {
      const ev = event as Event & {
        to: URL;
        formData?: FormData;
        signal: AbortSignal;
        loader: () => Promise<void>;
        newDocument?: Document;
        preventDefault: () => void;
      };
      if (ev.formData) return;

      const key = canon(ev.to.href);
      const originalLoader = ev.loader;

      ev.loader = async () => {
        let page = cache.get(key) ?? (await inflight.get(key));
        if (!page) {
          page = await fetchPage(ev.to.href, ev.signal);
          if (page) {
            cache.set(key, page);
            if (page.redirected) cache.set(canon(page.redirected), page);
          }
        }

        if (!page) {
          // 回退默认 loader（含整页跳转逻辑）
          await originalLoader();
          return;
        }

        if (page.redirected) {
          const next = new URL(page.redirected);
          if (next.origin !== ev.to.origin) {
            ev.preventDefault();
            return;
          }
          const hash = ev.to.hash;
          ev.to = next;
          ev.to.hash = hash;
        }

        const doc = new DOMParser().parseFromString(page.html, page.mediaType as DOMParserSupportedType);
        doc.querySelectorAll("noscript").forEach((n) => n.remove());
        if (!doc.querySelector('[name="astro-view-transitions-enabled"]')) {
          ev.preventDefault();
          return;
        }
        ev.newDocument = doc;
        if (!ev.signal.aborted) await preloadStyles(doc);
      };
    });

    document.addEventListener("astro:page-load", () => {
      // 主导航立刻预热；其余链接空闲时再拉
      document
        .querySelectorAll<HTMLAnchorElement>("a.hw-nav-link[href]")
        .forEach((a) => warm(a.href));
      const warmRest = () => warmLinks();
      "requestIdleCallback" in window
        ? requestIdleCallback(warmRest, { timeout: 1200 })
        : setTimeout(warmRest, 0);
    });

    // 指针按下时再保一次，覆盖 idle 尚未跑完就点击的情况
    document.addEventListener(
      "pointerdown",
      (event) => {
        const t = event.target;
        if (!(t instanceof Element)) return;
        const a = t.closest<HTMLAnchorElement>("a[href]");
        if (!a || a.hasAttribute("download")) return;
        warm(a.href);
      },
      { capture: true, passive: true },
    );
  }
</script>
