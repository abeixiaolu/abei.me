# SPA：HTML 壳可短缓存；静态资源长缓存
/
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/index.html
  Cache-Control: public, max-age=600, stale-while-revalidate=86400

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
