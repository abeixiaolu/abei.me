---
/**
 * SPEC-01 / Hardware · 56 LCD
 * 灰色反射玻璃窗 + 凹陷井，标签与正文印在玻璃上。
 * @see https://spec-01.vercel.app/
 */
interface Props {
  size?: "sm" | "md" | "lg";
  class?: string;
}

const { size = "md", class: className } = Astro.props;
---

<div class:list={["hw-lcd", className]} data-size={size}>
  <slot />
</div>
