---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";
import Header from "../components/Header.astro";
import NavHtmlCache from "../components/NavHtmlCache.astro";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "阿北的个人站点" } = Astro.props;
const pageTitle = title === "abei" ? "abei" : `${title} · abei`;

/** transitions-dev · page side-by-side → View Transition 主内容 */
const pageReveal = {
  forwards: {
    old: {
      name: "t-page-out",
      duration: "var(--page-slide-dur)",
      easing: "var(--page-slide-ease)",
    },
    new: {
      name: "t-page-in",
      duration: "var(--page-slide-dur)",
      easing: "var(--page-slide-ease)",
    },
  },
  backwards: {
    old: {
      name: "t-page-out-back",
      duration: "var(--page-slide-dur)",
      easing: "var(--page-slide-ease)",
    },
    new: {
      name: "t-page-in-back",
      duration: "var(--page-slide-dur)",
      easing: "var(--page-slide-ease)",
    },
  },
};
---

<!doctype html>
<html lang="zh-CN" transition:animate="none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/logo.svg" />
    <link
      rel="preload"
      href="/fonts/BerkeleyMonoVariable.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SarasaGothicSC-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/SarasaGothicSC-SemiBold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body class="min-h-dvh">
    <div class="mx-auto flex min-h-dvh max-w-3xl flex-col px-4 py-5 sm:px-6 sm:py-7">
      <Header />
      <main class="flex-1 py-8 sm:py-10" transition:animate={pageReveal}>
        <slot />
      </main>
      <footer class="hw-footer" transition:animate="none">
        <p>© {new Date().getFullYear()} abei</p>
      </footer>
    </div>
    <NavHtmlCache />
  </body>
</html>
