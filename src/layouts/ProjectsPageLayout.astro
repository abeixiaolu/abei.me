---
import Badge from "../components/Badge.astro";
import Lcd from "../components/Lcd.astro";
import BaseLayout from "./BaseLayout.astro";

interface Project {
  name: string;
  description: string;
  url: string;
}

interface ProjectGroup {
  title: string;
  projects: Project[];
}

const { frontmatter } = Astro.props;
const {
  title,
  description,
  caption,
  lede,
  groups = [],
} = frontmatter as {
  title: string;
  description?: string;
  caption?: string;
  lede?: string;
  groups?: ProjectGroup[];
};

function isRepo(url: string) {
  try {
    return new URL(url).hostname.includes("github.com");
  } catch {
    return false;
  }
}

function padIndex(n: number) {
  return String(n).padStart(2, "0");
}
---

<BaseLayout title={title} description={description}>
  <section>
    <Lcd size="lg">
      {caption && <p class="hw-caption">{caption}</p>}
      <h1 class="hw-title">{title}</h1>
      {lede && <p class="hw-lede">{lede}</p>}
    </Lcd>

    <div class="mt-8 space-y-8">
      {
        groups.map((group) => (
          <div>
            <div class="mb-3 flex items-center justify-between gap-3">
              <Badge>{group.title}</Badge>
              <span class="font-mono text-[9px] uppercase tracking-[0.14em] text-dim">
                Bank · {padIndex(group.projects.length)} pads
              </span>
            </div>

            <div class="hw-pad-bank">
              <ul class="hw-pad-grid">
                {group.projects.map((project, i) => {
                  const repo = isRepo(project.url);
                  return (
                    <li>
                      <a
                        href={project.url}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="hw-key hw-pad"
                      >
                        <span class="hw-key-pad hw-pad-face">
                          <span class="hw-pad-meta">
                            <span class="hw-pad-index">{padIndex(i + 1)}</span>
                            <span class="hw-pad-status">
                              <span
                                class="hw-pad-led"
                                data-tone={repo ? "repo" : "live"}
                                aria-hidden="true"
                              />
                              <span>{repo ? "Repo" : "Live"}</span>
                            </span>
                          </span>

                          <span class="hw-pad-title">
                            <span
                              class:list={[
                                "shrink-0 text-base opacity-70",
                                repo
                                  ? "i-carbon-logo-github"
                                  : "i-carbon-direction-right-01-filled",
                              ]}
                              aria-hidden="true"
                            />
                            {project.name}
                          </span>

                          <span class="hw-pad-desc">{project.description}</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
