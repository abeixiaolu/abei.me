---
import Badge from "../components/Badge.astro";
import Lcd from "../components/Lcd.astro";
import BaseLayout from "./BaseLayout.astro";

interface Project {
  name: string;
  description: string;
  url: string;
}

interface ProjectGroup {
  title: string;
  projects: Project[];
}

const { frontmatter } = Astro.props;
const {
  title,
  description,
  caption,
  lede,
  groups = [],
} = frontmatter as {
  title: string;
  description?: string;
  caption?: string;
  lede?: string;
  groups?: ProjectGroup[];
};
---

<BaseLayout title={title} description={description}>
  <section>
    <Lcd size="lg">
      {caption && <p class="hw-caption">{caption}</p>}
      <h1 class="hw-title">{title}</h1>
      {lede && <p class="hw-lede">{lede}</p>}
    </Lcd>

    <div class="mt-8 space-y-8">
      {
        groups.map((group) => (
          <div>
            <div class="mb-3 flex items-center gap-2">
              <Badge>{group.title}</Badge>
            </div>
            <ul class="grid gap-2 sm:grid-cols-1">
              {group.projects.map((project) => (
                <li>
                  <a
                    href={project.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hw-key"
                  >
                    <span class="hw-key-pad flex items-start justify-between gap-4">
                      <span class="min-w-0">
                        <span class="inline-flex items-center gap-2 font-medium">
                          <span
                            class="i-carbon-logo-github text-base opacity-70"
                            aria-hidden="true"
                          />
                          {project.name}
                        </span>
                        <span class="mt-1.5 block text-[12px] leading-relaxed text-dim">
                          {project.description}
                        </span>
                      </span>
                      <span
                        class="i-carbon-arrow-up-right mt-0.5 shrink-0 text-dim"
                        aria-hidden="true"
                      />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>
</BaseLayout>
