---
import { getCollection } from "astro:content";
import ItemList from "../../components/ItemList.astro";
import Lcd from "../../components/Lcd.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const allPosts = await getCollection("blog");
const seriesRoots = new Set(
  allPosts
    .filter((post) => post.data.series)
    .map((post) => post.id.replace(/\/index$/, "")),
);

const posts = allPosts
  .filter((post) => !post.data.hidden)
  .filter((post) => {
    // 系列子文章归入系列，不在列表单独展示
    const root = post.id.split("/")[0];
    return !(post.id.includes("/") && seriesRoots.has(root));
  })
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function formatDate(date: Date) {
  return date.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
}
---

<BaseLayout title="Blog" description="技术笔记、教程与碎碎念。">
  <section>
    <Lcd size="lg">
      <p class="hw-caption">Index</p>
      <h1 class="hw-title">Blog</h1>
      <p class="hw-lede">技术笔记、教程与碎碎念。</p>
    </Lcd>

    <ItemList class="mt-8">
      <div class="hw-item-list-head" aria-hidden="true">
        <span>Title</span>
        <span data-align="end">Date</span>
      </div>
      <div class="hw-item-list-body" role="list">
        {
          posts.map((post) => (
            <a
              href={`/blog/${post.id}`}
              class="hw-item-list-row"
              role="listitem"
            >
              <span>{post.data.title}</span>
              <time
                datetime={post.data.date.toISOString()}
                data-align="end"
              >
                {formatDate(post.data.date)}
              </time>
            </a>
          ))
        }
      </div>
    </ItemList>
  </section>
</BaseLayout>
