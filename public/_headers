# Cloudflare Pages：HTML 允许边缘短缓存，减轻 ClientRouter 每次切换的回源等待
/
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/diary/*
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/blog/*
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/projects/*
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/uses/*
  Cache-Control: public, max-age=0, s-maxage=60, must-revalidate

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable
